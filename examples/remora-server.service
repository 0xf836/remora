[Unit]
Description=Remora MASQUE UDP proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=remora
Group=remora
ExecStart=/usr/local/bin/remora server --config /etc/remora/server.toml
# Configure [diagnostics] in server.toml; RUST_LOG is not used.
# Text operator logs use stderr; JSON capture is an explicitly selected profile.
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target
